APP_NAME=FastAPI Boilerplate
SECRET_KEY=change-me-to-a-very-long-random-string
# For local development outside Docker. docker compose overrides this with the
# "postgres" service host automatically.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/boilerplate
FRONTEND_HOST=http://localhost:3000

# Used by docker compose to build the DATABASE_URL override.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=boilerplate

# First administrator user, created by src/seed.py on first execution.
# ALWAYS change ADMIN_PASSWORD before going to production.
ADMIN_EMAIL=admin@boilerplate.com
ADMIN_PASSWORD=admin
ADMIN_NAME=Admin
ADMIN_SURNAME=User